{
  "name": "elite-editor",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/opencut-dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:browser": "node scripts/build-browser-editor.mjs",
    "start": "node server/index.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "analyze": "node scripts/cli.mjs analyze",
    "edit": "node scripts/cli.mjs edit",
    "render": "node scripts/cli.mjs render",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/enhanced-source-integration.mjs",
    "model:tiny": "node scripts/model.mjs",
    "test:ui": "node tests/opencut-assistant-ui.mjs && node tests/assistant-parts-ui.mjs && node tests/assistant-publish-ui.mjs && node tests/beauty-inspector-ui.mjs && node tests/library-panel-ui.mjs",
    "forge": "node scripts/forge.mjs",
    "setup": "node scripts/init-public.mjs",
    "dev:legacy": "node scripts/dev.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:integration"
  },
  "dependencies": {
    "@remotion/player": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "description": "Local-first video editing with an integrated AI assistant",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
